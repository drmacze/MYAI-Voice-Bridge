# MYAI Render Voice Bridge v0.6.2
# Add these as Render Environment variables. Never commit real secrets.

# REQUIRED: Falix remote console
FALIX_API_KEY=
FALIX_SERVER_NAME=Motion Roleplay
FALIX_SERVER_ID=
FALIX_API_BASE=https://client.falixnodes.net/api/v2

# Pairing
MYAI_REQUIRE_PAIR=true
MYAI_SESSION_HOURS=168

# Brain providers — configure one or more
OPENAI_API_KEY=
MYAI_OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
MYAI_GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=
MYAI_ANTHROPIC_MODEL=claude-sonnet-5
OPENROUTER_API_KEY=
MYAI_OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_API_KEY=
MYAI_DEEPSEEK_MODEL=deepseek-v4-flash

# Speech-to-text. Microphone input needs OpenAI or Gemini.
MYAI_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MYAI_GEMINI_TRANSCRIBE_MODEL=gemini-3.7-flash
